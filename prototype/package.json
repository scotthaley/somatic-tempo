    "room:check": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "partysocket": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5",
    "partyserver": "^0.5.10",
    "typescript": "^5.8.0",
    "vite": "^7",
    "vite-node": "^3",
    "vitest": "^3",
    "wrangler": "^4.134.0"
  }
}
