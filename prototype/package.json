{
  "name": "somatic-tempo-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "vite-node scripts/sim.ts",
    "tauri": "tauri",
    "room:dev": "wrangler dev --config server/wrangler.jsonc",
